{
  "name": "orgai",
  "version": "0.1.0",
  "description": "A provider-agnostic harness that runs a project's org chart of AI agents and visualizes the work live.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:watch": "vitest",
    "e2e:free": "node e2e/layout.mjs && node e2e/maintenance.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "6.0.0",
    "playwright-core": "^1.58.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@dagrejs/dagre": "3.1.3",
    "@openai/codex": "0.166.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  }
}
