<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The spawned native claude and codex binaries are signed by their vendors, not by us. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Anthropic, OpenAI, LiteLLM and MCP traffic. The app is not sandboxed, so this is informational. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
