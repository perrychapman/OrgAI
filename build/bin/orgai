#!/bin/sh
# The orgai command of a packaged OrgAI (cli-spec 7, Wave 6). electron-builder copies this file to
# <Resources>/bin/orgai (extraResources). It runs the app's own binary as Node (ELECTRON_RUN_AS_NODE=1) on the CLI
# bundle in <Resources>/app.asar.unpacked/out/cli, the way VS Code's `code` command does. A shim on PATH
# (~/.local/bin/orgai, written by OrgAI) or a symlink may point here: links are followed to find <Resources>.

self=$0
# Follow symlinks (relative ones against the link's own folder) to the real file.
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
bin=$(cd -P "$(dirname "$self")" && pwd) || exit 1
res=$(cd -P "$bin/.." && pwd) || exit 1

if [ "$(uname -s)" = "Darwin" ]; then
  app=$res/../MacOS/OrgAI
else
  app=$res/../orgai
fi
cli=$res/app.asar.unpacked/out/cli/orgai.mjs

if [ ! -x "$app" ]; then
  echo "orgai: the OrgAI app next to this command is missing ($app). Reinstall OrgAI." >&2
  exit 1
fi
if [ ! -f "$cli" ]; then
  echo "orgai: the OrgAI command line bundle is missing ($cli). Reinstall OrgAI." >&2
  exit 1
fi

ELECTRON_RUN_AS_NODE=1 exec "$app" "$cli" "$@"
